# customer-service (Terminal A)
# export DB_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT:5432/lawn_customers
# export DB_USERNAME=lawn_admin
# export DB_PASSWORD=your-secure-password
# mvn -pl customer-service spring-boot:run -Dspring-boot.run.profiles=aws

# signup-service (Terminal B) — use lawn_signups database on same or different RDS instance
# export DB_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT:5432/lawn_signups
# export DB_USERNAME=lawn_admin
# export DB_PASSWORD=your-secure-password
# mvn -pl signup-service spring-boot:run -Dspring-boot.run.profiles=aws
